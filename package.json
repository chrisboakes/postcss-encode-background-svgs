{
  "name": "postcss-encode-background-svgs",
  "version": "2.0.0",
  "description": "PostCSS plugin to urlencode background svgs",
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "urlencode",
    "encode",
    "background-svg",
    "svg"
  ],
  "author": "Chris Boakes <chris@chrisboakes.com>",
  "license": "MIT",
  "repository": "chrisboakes/postcss-encode-background-svgs",
  "bugs": {
    "url": "https://github.com/chrisboakes/postcss-encode-background-svgs/issues"
  },
  "homepage": "https://github.com/chrisboakes/postcss-encode-background-svgs",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "postcss": "^8.4.31"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "postcss": "^8.5.16",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
